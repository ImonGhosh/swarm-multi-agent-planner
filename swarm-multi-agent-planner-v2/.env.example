# Copy to .env and fill in. Never commit .env.

# --- Backend (OpenRouter by default) -------------------------------------
OPENROUTER_API_KEY=
# LLM_BASE_URL=https://openrouter.ai/api/v1     # any OpenAI-compatible endpoint (e.g. Ollama)

# --- OpenRouter provider routing -----------------------------------------
# Runs are pinned to ONE provider with no fallback (default DeepInfra), so an outage stops
# the run instead of silently switching backend. Every call records the provider that answered.
# OPENROUTER_PROVIDER_ONLY=DeepInfra             # comma-separated provider names, or "any" to unpin
# OPENROUTER_ALLOW_FALLBACKS=false               # default false when pinned, true when not
# OPENROUTER_PROVIDER_SORT=throughput            # price | throughput | latency (only when not pinned)
# OPENROUTER_PROVIDER_IGNORE=                    # comma-separated provider names
# OPENROUTER_PROVIDER_DATA_COLLECTION=           # allow | deny

# --- Per-request retry/backoff (transient provider errors, HTTP 429/5xx) ---
# OPENROUTER_MAX_RETRIES=12
# OPENROUTER_RETRY_BASE_SECONDS=2.0
# OPENROUTER_RETRY_MAX_SECONDS=90.0

# --- Agent-level pacing (does not change the search budget) --------------
# Provider load is capped globally by --max_concurrent_requests, not by this.
# ACO_MAX_PARALLEL_AGENTS=8                      # default: all agents of a task at once
# ACO_AGENT_MAX_ATTEMPTS=3
# ACO_AGENT_RETRY_BASE_SECONDS=3.0
# ACO_AGENT_RETRY_MAX_SECONDS=60.0
